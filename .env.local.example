# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# Firebase → Configurações do projeto → Seus apps → Web → Configuração do SDK
#
# Sem estas variáveis o sistema roda em modo demonstração (dados só no
# navegador). Basta preencher e reiniciar o `npm run dev` pra ligar o Firestore.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Upload de fotos de produto (Cloudinary — cloudinary.com, plano free).
# Cloud name: painel do Cloudinary, canto superior esquerdo.
# Upload preset: Settings → Upload → Upload presets → Add upload preset →
# Signing Mode = "Unsigned" (precisa ser unsigned pra funcionar direto do navegador).
# Sem essas variáveis, o sistema guarda a foto como base64 direto no Firestore.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
